VITE_SUPABASE_PROJECT_ID="PROJECT_REF"
VITE_SUPABASE_URL="https://PROJECT_REF.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="sb_publishable_xxx"

# Alamat backend HopeAI (tanpa garis miring di akhir)
VITE_API_URL="http://localhost:5114"

# Tombol "Lanjutkan dengan ..." di halaman masuk. Isi hanya penyedia yang sudah
# diaktifkan di Supabase (Authentication > Sign In / Providers), dipisah koma.
# Tanpa variabel ini yang tampil hanya Google. Isi "" untuk menyembunyikan semua tombol.
VITE_AUTH_PROVIDERS="google"
